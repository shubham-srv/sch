# Copy to .env.local for local development. `yarn dev`, `yarn start` and
# `yarn test:e2e` read it. In Azure these are Web App app settings.

# Backend API base URL, read by the Next.js server at runtime (never by the
# browser). May include a path prefix, e.g. https://backend.example.com/api;
# the client appends request paths such as /orders. Locally, point it at your
# running backend container. TODO(owner): confirm the local backend's port.
API_BASE_URL=http://localhost:8080

# --- Microsoft Entra ID sign-in, through Auth.js (docs/deployment-azure.md) ---

# Public origin of this app, with no path: exactly the address you open in the
# browser. Microsoft sends the browser back to
# <AUTH_URL>/api/auth/callback/microsoft-entra-id, which must be a redirect URI
# of the app registration. Cookies are Secure when this is https.
AUTH_URL=http://localhost:3000

# From the app registration's Overview page: the application (client) id, and
# the issuer built from the directory (tenant) id.
AUTH_MICROSOFT_ENTRA_ID_ID=<client-id>
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# A client secret of the app registration. In Azure, a Key Vault reference.
AUTH_MICROSOFT_ENTRA_ID_SECRET=<client-secret>
# The backend API's delegated scope.
ENTRA_API_SCOPE=api://<backend-app-id>/access_scan

# Encrypts the session cookie: at least 32 characters, random, never shared
# between environments. Changing it signs everyone out. To generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In Azure, a Key Vault reference.
AUTH_SECRET=<at-least-32-random-characters>

# --- E2E only ---

# A test account without MFA that may sign in to the app. Playwright and pa11y
# sign in through Microsoft's screens with it.
# E2E_USERNAME=e2e-user@contoso.example
# E2E_PASSWORD=

# Optional, for the sample greeting page (the frontend-backend connectivity
# check): the exact greeting the backend returns. When unset, the test only
# checks that the page heading is not empty.
# E2E_EXPECTED_GREETING=hello world

# Optional: the test account's display name, checked in the top bar.
# E2E_EXPECTED_USER_NAME=E2E Test User
