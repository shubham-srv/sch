# Copy to .env.local for local development. `next dev`, `next start` and
# `pnpm api:types:pull` read it. In Azure these are Web App app settings.

# Backend API base URL, read by the Next.js server at runtime (never by the
# browser). May include a path prefix, e.g. https://backend.example.com/api;
# the client appends /greeting. The local value points at `pnpm mock-api`.
API_BASE_URL=http://localhost:4010

# OpenAPI document of the backend, used only by `pnpm api:types:pull`.
# TODO(owner): set to the real backend's OpenAPI endpoint.
OPENAPI_URL=http://localhost:5000/openapi/v1.json
