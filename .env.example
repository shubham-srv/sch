# Copy to .env.local for local development. `pnpm dev`, `pnpm start` and
# `pnpm test:e2e` read it. In Azure these are Web App app settings.

# Backend API base URL, read by the Next.js server at runtime (never by the
# browser). May include a path prefix, e.g. https://backend.example.com/api;
# the client appends /greeting. Locally, point it at your running backend
# container. TODO(owner): confirm the local backend's port.
API_BASE_URL=http://localhost:8080

# Optional, E2E only: the exact greeting the backend returns. When unset, the
# E2E test only checks that the page heading is not empty.
# E2E_EXPECTED_GREETING=hello world
