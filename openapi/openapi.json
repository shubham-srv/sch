{
  "openapi": "3.1.0",
  "info": {
    "title": "Backend API",
    "version": "0.1.0",
    "description": "Hand-written snapshot of the backend contract used by the frontend. TODO(owner): confirm with the backend owner, then replace with `pnpm api:types:pull`."
  },
  "paths": {
    "/greeting": {
      "get": {
        "operationId": "getGreeting",
        "summary": "Returns a greeting message.",
        "responses": {
          "200": {
            "description": "The greeting.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Greeting" }
              }
            }
          },
          "default": {
            "description": "An error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Greeting": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
